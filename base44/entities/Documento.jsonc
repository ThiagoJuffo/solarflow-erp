{
  "name": "Documento",
  "type": "object",
  "properties": {
    "projeto_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "procuracao",
        "memorial_tecnico",
        "formulario_creditos",
        "art",
        "inmetro",
        "requerimento",
        "conta_energia",
        "outros_anexos",
        "relatorio_entrega"
      ]
    },
    "titulo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "gerado",
        "enviado_para_assinatura",
        "assinado",
        "pendente",
        "pendente_cliente",
        "sem_padrao",
        "nao_aplicavel"
      ],
      "default": "pendente"
    },
    "url_gerado": {
      "type": "string",
      "description": "URL do PDF gerado pelo sistema"
    },
    "url_assinado": {
      "type": "string",
      "description": "URL do PDF assinado pelo cliente"
    },
    "data_geracao": {
      "type": "string",
      "format": "date-time"
    },
    "data_assinatura": {
      "type": "string",
      "format": "date-time"
    },
    "assinado_por": {
      "type": "string"
    },
    "metadados": {
      "type": "object"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "projeto_id",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vendas"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        },
        {
          "user_condition": {
            "role": "suprimentos"
          }
        },
        {
          "user_condition": {
            "role": "instalacao"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        }
      ]
    }
  }
}