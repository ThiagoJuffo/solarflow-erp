{
  "name": "BaixaFinanceira",
  "type": "object",
  "properties": {
    "lancamento_id": {
      "type": "string"
    },
    "conta_financeira_id": {
      "type": "string"
    },
    "valor": {
      "type": "number"
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "pix",
        "boleto",
        "cartao",
        "transferencia",
        "dinheiro",
        "financiamento",
        "debito_automatico"
      ]
    },
    "comprovante_uri": {
      "type": "string"
    },
    "origem": {
      "type": "string",
      "enum": [
        "manual",
        "conciliacao",
        "cadastro_inicial"
      ],
      "default": "manual"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "estornada"
      ],
      "default": "ativa"
    },
    "movimento_extrato_id": {
      "type": "string"
    },
    "estornada_em": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_estorno": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "delete": false
  },
  "required": [
    "lancamento_id",
    "valor",
    "data"
  ]
}