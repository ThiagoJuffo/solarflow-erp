{
  "name": "ImportacaoExtrato",
  "type": "object",
  "properties": {
    "conta_financeira_id": {
      "type": "string"
    },
    "nome_arquivo": {
      "type": "string"
    },
    "arquivo_uri": {
      "type": "string",
      "description": "Arquivo privado do extrato banc\u00e1rio"
    },
    "banco": {
      "type": "string"
    },
    "periodo_inicio": {
      "type": "string",
      "format": "date"
    },
    "periodo_fim": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "processando",
        "processado",
        "revisado",
        "erro"
      ],
      "default": "processando"
    },
    "total_movimentos": {
      "type": "integer",
      "default": 0
    },
    "total_creditos": {
      "type": "number",
      "default": 0
    },
    "total_debitos": {
      "type": "number",
      "default": 0
    },
    "arquivo_hash": {
      "type": "string",
      "description": "SHA-256 usado para impedir a importa\u00e7\u00e3o repetida do mesmo arquivo"
    },
    "movimentos_duplicados": {
      "type": "integer",
      "default": 0
    },
    "mensagem_erro": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "delete": false
  },
  "required": [
    "conta_financeira_id",
    "nome_arquivo"
  ]
}