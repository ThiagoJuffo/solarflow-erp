{
  "name": "Protocolo",
  "type": "object",
  "properties": {
    "projeto_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "PROJETO",
        "VISTORIA"
      ]
    },
    "numero_protocolo": {
      "type": "string"
    },
    "data_entrada": {
      "type": "string",
      "format": "date"
    },
    "modalidade": {
      "type": "string",
      "enum": [
        "convencional",
        "fast_track"
      ],
      "default": "convencional",
      "description": "Modalidade do pedido de aprova\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "pendente",
        "em_analise",
        "concluido",
        "indeferido"
      ],
      "default": "aberto"
    },
    "pendencias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "resolvida": {
            "type": "boolean"
          },
          "data_resolucao": {
            "type": "string"
          }
        }
      }
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_resposta": {
      "type": "string",
      "format": "date"
    },
    "resultado": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "edp_consulta": {
      "type": "object",
      "description": "\u00daltimo resultado da consulta no EDP Online via extens\u00e3o"
    }
  },
  "required": [
    "projeto_id",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vendas"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        },
        {
          "user_condition": {
            "role": "suprimentos"
          }
        },
        {
          "user_condition": {
            "role": "instalacao"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        }
      ]
    }
  }
}