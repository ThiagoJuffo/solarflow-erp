{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "calendar_id": {
      "type": "string",
      "description": "ID do calend\u00e1rio Google ao qual este sync token pertence"
    },
    "sync_token": {
      "type": "string",
      "description": "Token de sincroniza\u00e7\u00e3o incremental do Google Calendar API"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  },
  "required": [
    "calendar_id",
    "sync_token"
  ]
}