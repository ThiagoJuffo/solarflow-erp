{
  "name": "Vendedor",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do vendedor"
    },
    "telefone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "vendas"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        },
        {
          "user_condition": {
            "role": "suprimentos"
          }
        },
        {
          "user_condition": {
            "role": "instalacao"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}