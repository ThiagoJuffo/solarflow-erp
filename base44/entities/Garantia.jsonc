{
  "name": "Garantia",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "sn": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "inversor",
        "antena"
      ]
    },
    "marca": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "aprovado",
        "recusado",
        "concluido"
      ],
      "default": "aberto"
    },
    "inicio_tratativas": {
      "type": "string",
      "format": "date"
    },
    "numero_protocolo": {
      "type": "string"
    },
    "endereco": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        },
        {
          "user_condition": {
            "role": "instalacao"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        },
        {
          "user_condition": {
            "role": "instalacao"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        },
        {
          "user_condition": {
            "role": "instalacao"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "engenharia"
          }
        }
      ]
    }
  }
}