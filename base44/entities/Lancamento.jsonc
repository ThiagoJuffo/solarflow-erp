{
  "name": "Lancamento",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "receita",
        "despesa"
      ],
      "description": "Tipo do lan\u00e7amento financeiro"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "venda_projeto",
        "comissao",
        "kit_equipamentos",
        "mao_de_obra",
        "despesa_operacional",
        "despesa_marketing",
        "despesa_financeira",
        "imposto",
        "pro_labore",
        "distribuicao_lucro",
        "capex",
        "outros"
      ]
    },
    "descricao": {
      "type": "string"
    },
    "valor": {
      "type": "number"
    },
    "data_competencia": {
      "type": "string",
      "format": "date"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "parcial",
        "pago",
        "atrasado",
        "cancelado"
      ],
      "default": "pendente"
    },
    "projeto_id": {
      "type": "string",
      "description": "Vincula\u00e7\u00e3o opcional ao projeto"
    },
    "conta_financeira_id": {
      "type": "string",
      "description": "Conta banc\u00e1ria ou caixa usado na liquida\u00e7\u00e3o"
    },
    "centro_custo_id": {
      "type": "string",
      "description": "Centro de custo vinculado ao projeto, cliente ou departamento"
    },
    "centro_custo": {
      "type": "string",
      "enum": [
        "projetos",
        "administrativo",
        "comercial",
        "marketing",
        "operacional",
        "tributos",
        "pessoal",
        "investimentos",
        "outros"
      ],
      "default": "operacional"
    },
    "nome_cliente_fornecedor": {
      "type": "string"
    },
    "documento_cliente_fornecedor": {
      "type": "string"
    },
    "numero_documento": {
      "type": "string"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "pix",
        "boleto",
        "cartao",
        "transferencia",
        "dinheiro",
        "financiamento",
        "debito_automatico"
      ]
    },
    "comprovante_url": {
      "type": "string"
    },
    "recorrente": {
      "type": "boolean",
      "default": false
    },
    "frequencia_recorrencia": {
      "type": "string",
      "enum": [
        "semanal",
        "mensal",
        "trimestral",
        "anual"
      ],
      "default": "mensal"
    },
    "quantidade_recorrencias": {
      "type": "integer",
      "default": 1
    },
    "valor_pago": {
      "type": "number",
      "default": 0
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "file_uri": {
            "type": "string"
          },
          "data_upload": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "parcela_atual": {
      "type": "integer",
      "default": 1
    },
    "total_parcelas": {
      "type": "integer",
      "default": 1
    },
    "conciliado": {
      "type": "boolean",
      "default": false
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "tipo",
    "descricao",
    "valor",
    "data_vencimento"
  ]
}