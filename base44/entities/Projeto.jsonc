{
  "name": "Projeto",
  "type": "object",
  "properties": {
    "pre_projeto_id": {
      "type": "string"
    },
    "nome_cliente": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pago_projeto_iniciado",
        "kit_confirmado",
        "documentos_gerados",
        "assinaturas_pendentes",
        "assinaturas_concluidas",
        "dossie_ok",
        "protocolado_edp",
        "aguardando_aprovacao",
        "aprovado",
        "indeferido",
        "em_revisao",
        "instalacao_agendada",
        "sistema_instalado",
        "vistoria_solicitada",
        "aguardando_vistoria",
        "vistoria_aprovada",
        "monitoramento_cadastrado",
        "concluido"
      ],
      "default": "pago_projeto_iniciado"
    },
    "motivo_indeferimento": {
      "type": "string"
    },
    "motivo_atraso_documentacao": {
      "type": "string",
      "description": "Justificativa para atraso na entrega do memorial descritivo e diagrama unifilar"
    },
    "equipamentos_confirmados": {
      "type": "boolean",
      "default": false
    },
    "equipamentos_confirmados_por": {
      "type": "string"
    },
    "equipamentos_confirmados_em": {
      "type": "string",
      "format": "date-time"
    },
    "transformador_confirmado": {
      "type": "boolean",
      "default": false
    },
    "transformador_confirmado_por": {
      "type": "string"
    },
    "transformador_confirmado_em": {
      "type": "string",
      "format": "date-time"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "pagamento_confirmado_por": {
      "type": "string"
    },
    "uc_geradora": {
      "type": "string"
    },
    "envio_creditos": {
      "type": "boolean",
      "default": false
    },
    "ucs_beneficiarias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero_uc": {
            "type": "string"
          },
          "titular": {
            "type": "string"
          },
          "percentual_rateio": {
            "type": "number"
          }
        }
      }
    },
    "monitoramento_portal": {
      "type": "string"
    },
    "monitoramento_login": {
      "type": "string"
    },
    "monitoramento_senha_encrypted": {
      "type": "string"
    },
    "monitoramento_auditoria": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "data_instalacao": {
      "type": "string",
      "format": "date"
    },
    "data_comissionamento": {
      "type": "string",
      "format": "date"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "ID do evento de instala\u00e7\u00e3o no Google Calendar (agendamento autom\u00e1tico)"
    },
    "google_calendar_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de todos os eventos de instala\u00e7\u00e3o no Google Calendar (instala\u00e7\u00f5es multi-dia)"
    },
    "continuacoes": {
      "type": "array",
      "description": "Continua\u00e7\u00f5es de instala\u00e7\u00e3o em dias n\u00e3o consecutivos (vinculadas \u00e0 instala\u00e7\u00e3o original)",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date"
          },
          "google_calendar_event_id": {
            "type": "string"
          },
          "concluida": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "evidencias_instalacao": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sistema_instalado": {
      "type": "boolean",
      "default": false
    },
    "concluido": {
      "type": "boolean",
      "default": false
    },
    "reagendamentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Hist\u00f3rico de reagendamentos de instala\u00e7\u00e3o"
    },
    "timeline_eventos": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "observacoes": {
      "type": "string"
    },
    "evento_orfao_google": {
      "type": "boolean",
      "default": false,
      "description": "Sinaliza que o evento no Google Calendar foi exclu\u00eddo e o registro est\u00e1 \u00f3rf\u00e3o"
    },
    "sync_origem": {
      "type": "string",
      "description": "Origem da \u00faltima sincroniza\u00e7\u00e3o: 'google' (webhook/polling) ou 'app' (a\u00e7\u00e3o do usu\u00e1rio)"
    }
  },
  "required": [
    "nome_cliente",
    "cpf"
  ]
}