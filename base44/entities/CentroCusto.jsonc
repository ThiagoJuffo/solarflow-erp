{
  "name": "CentroCusto",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "projeto_cliente",
        "departamento",
        "administrativo",
        "subcentro",
        "outros"
      ],
      "default": "projeto_cliente"
    },
    "centro_pai_id": {
      "type": "string",
      "description": "Centro de custo principal quando este registro for um subcentro"
    },
    "projeto_id": {
      "type": "string",
      "description": "Projeto/cliente relacionado ao centro de custo"
    },
    "cliente_nome": {
      "type": "string"
    },
    "orcamento": {
      "type": "number",
      "default": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "financeiro"
          }
        }
      ]
    },
    "delete": false
  },
  "required": [
    "nome",
    "tipo"
  ]
}