{
  "name": "Agendar Instala\u00e7\u00e3o Autom\u00e1tica",
  "description": "Cria evento no Google Calendar 60 dias ap\u00f3s confirma\u00e7\u00e3o do kit, apenas quando kit passa de false para true e pagamento existe.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"equipamentos_confirmados\") != null) and (.trigger.data.equipamentos_confirmados == true) and (.trigger.old_data.equipamentos_confirmados == false) and (.trigger.data.data_pagamento != null and .trigger.data.data_pagamento != \"\" and .trigger.data.data_pagamento != [] and .trigger.data.data_pagamento != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Projeto"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agendar_instala_o_autom_tica",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agendarInstalacaoAutomatica",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "agendarInstalacaoAutomatica"
  }
}